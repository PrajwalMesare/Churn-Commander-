# ═══════════════════════════════════════════════════════════════════════════════
# CHURN COMMANDER v2.0 - SECRETS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Fill in your API keys and credentials below
# 3. DO NOT commit secrets.toml to GitHub (it's in .gitignore)
# 4. For production, use Streamlit Cloud Secrets Manager
#
# ═══════════════════════════════════════════════════════════════════════════════

# Google Gemini AI API
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# Email Configuration - Gmail SMTP
# Use Gmail App Password (not your regular password)
# Setup: https://support.google.com/accounts/answer/185833
EMAIL_SENDER = "your.email@gmail.com"
EMAIL_PASSWORD = "your-gmail-app-password-here"
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587

# Email Configuration - SendGrid API (Alternative)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Uncomment to use SendGrid instead of Gmail
# SENDGRID_API_KEY = "your-sendgrid-api-key-here"

# Database Configuration (Optional)
# For storing email logs and customer data persistently
# DATABASE_URL = "postgresql://user:password@localhost/churn_db"
# Or for SQLite (local):
# DATABASE_URL = "sqlite:///./churn_commander.db"

# Logging Configuration
# LOG_LEVEL = "INFO"
# LOG_FILE = "logs/app.log"

# Rate Limiting
# MAX_EMAILS_PER_HOUR = 100
# MAX_PREDICTIONS_PER_HOUR = 1000

# Miscellaneous
# APP_SECRET_KEY = "your-secret-key-for-encryption"
# ENVIRONMENT = "development"  # or "production"
